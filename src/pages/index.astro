---
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Faq from '../components/sections/Faq.astro';
import Hero from '../components/sections/Hero.astro';
import Journey from '../components/sections/Journey.astro';
import Process from '../components/sections/Process.astro';
import Projects from '../components/sections/Projects.astro';
import Services from '../components/sections/Services.astro';
import { SITE } from '../config/site';
import Layout from '../layouts/Layout.astro';
import { businessNode, faqNode, personId, projectNodes, serviceNodes, webpageId, websiteId } from '../lib/schema';

const profilePage = {
  '@type': 'ProfilePage' as const,
  '@id': webpageId,
  url: `${SITE.url}/`,
  name: SITE.title,
  description: SITE.description,
  inLanguage: SITE.locale,
  isPartOf: { '@id': websiteId },
  mainEntity: { '@id': personId },
  dateModified: new Date().toISOString(),
};
---

<Layout type="profile" schema={[profilePage, businessNode(), ...serviceNodes(), faqNode(), ...projectNodes()]}>
  <Hero />
  <Services />
  <Process />
  <Projects />
  <About />
  <Journey />
  <Faq />
  <Contact />
</Layout>
