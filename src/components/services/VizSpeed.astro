---
// "Renovar tu web": indicador de rendimiento que sube hasta verde. Ilustración, no una métrica real.
const SCORE = 98;
const R = 44;
const C = 2 * Math.PI * R;
---

<div class="viz absolute inset-0 grid place-items-center p-6" data-viz aria-hidden="true">
  <div class="flex flex-col items-center">
    <div class="relative size-36">
      <svg viewBox="0 0 100 100" class="size-full -rotate-90">
        <defs>
          <linearGradient id="speed-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--accent-2)"></stop>
            <stop offset="100%" stop-color="var(--accent)"></stop>
          </linearGradient>
        </defs>
        <circle cx="50" cy="50" r={R} fill="none" stroke="var(--border-strong)" stroke-width="6"></circle>
        <circle
          class="ring"
          cx="50"
          cy="50"
          r={R}
          fill="none"
          stroke="url(#speed-gradient)"
          stroke-width="6"
          stroke-linecap="round"
          stroke-dasharray={C}
          style={`--c: ${C}; --offset: ${C * (1 - SCORE / 100)}`}
        ></circle>
      </svg>
      <span
        class="score absolute inset-0 grid place-items-center text-4xl font-semibold tracking-tight"
        style={`--to: ${SCORE}`}
      ></span>
    </div>
    <p class="mt-3 font-mono text-xs tracking-wider text-muted uppercase">Rendimiento</p>
    <ul class="mt-4 flex gap-2">
      {['Rápida', 'Móvil', 'SEO'].map((metric, i) => (
        <li
          class="chip flex items-center gap-1.5 rounded-full border border-border bg-bg px-2.5 py-1 font-mono text-[0.6875rem]"
          style={`--i: ${i}`}
        >
          <span class="size-1.5 rounded-full bg-accent" />
          {metric}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* El número cuenta solo con CSS: una propiedad registrada se puede animar como entero. */
  @property --n {
    syntax: '<integer>';
    initial-value: 0;
    inherits: false;
  }
  .ring {
    stroke-dashoffset: var(--offset);
  }
  .score {
    --n: var(--to);
    counter-reset: n var(--n);
  }
  .score::after {
    content: counter(n);
  }
  :global(.js) .viz:not([data-inview]) .ring {
    stroke-dashoffset: var(--c);
  }
  :global(.js) .viz:not([data-inview]) .score {
    --n: 0;
  }
  :global(.js) .viz:not([data-inview]) .chip {
    opacity: 0;
  }
  .viz[data-inview] .ring {
    animation: ring 1.8s var(--ease-out-quart) 0.2s both;
  }
  .viz[data-inview] .score {
    animation: count 1.8s var(--ease-out-quart) 0.2s both;
  }
  .viz[data-inview] .chip {
    animation: chip 0.5s var(--ease-out-expo) both;
    animation-delay: calc(1.4s + var(--i) * 120ms);
  }
  @keyframes ring {
    from {
      stroke-dashoffset: var(--c);
    }
  }
  @keyframes count {
    from {
      --n: 12;
    }
  }
  @keyframes chip {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
