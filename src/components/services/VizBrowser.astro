---
// "Página web nueva": una web que se construye sola dentro de una ventana de navegador.
---

<div class="viz absolute inset-0 flex justify-center px-6 pt-8" data-viz aria-hidden="true">
  <div class="w-full max-w-[30rem] overflow-hidden rounded-lg border border-border-strong bg-bg">
    <div class="flex items-center gap-2 border-b border-border px-3 py-2">
      <span class="size-2 rounded-full bg-faint/60"></span>
      <span class="size-2 rounded-full bg-faint/60"></span>
      <span class="size-2 rounded-full bg-faint/60"></span>
      <span class="ml-3 flex-1 rounded-full bg-surface px-3 py-0.5 font-mono text-[0.625rem] text-muted">
        tunegocio.es
      </span>
    </div>
    <div class="space-y-3 p-4">
      <div class="build flex items-center justify-between" style="--i: 0">
        <span class="h-2 w-14 rounded-full bg-fg/70"></span>
        <span class="flex gap-2">
          <span class="h-1.5 w-8 rounded-full bg-faint/50"></span>
          <span class="h-1.5 w-8 rounded-full bg-faint/50"></span>
          <span class="h-1.5 w-8 rounded-full bg-faint/50"></span>
        </span>
      </div>
      <div class="build space-y-2 pt-3" style="--i: 1">
        <span class="block h-3.5 w-3/4 rounded-full bg-fg/80"></span>
        <span class="block h-3.5 w-1/2 rounded-full bg-gradient-signal"></span>
      </div>
      <div class="build space-y-1.5" style="--i: 2">
        <span class="block h-1.5 w-5/6 rounded-full bg-faint/50"></span>
        <span class="block h-1.5 w-2/3 rounded-full bg-faint/50"></span>
      </div>
      <div class="build flex gap-2 pt-1" style="--i: 3">
        <span class="cta h-6 w-24 rounded-full bg-accent"></span>
        <span class="h-6 w-20 rounded-full border border-border-strong"></span>
      </div>
      <div class="grid grid-cols-3 gap-2 pt-2">
        <span class="build h-14 rounded-md border border-border bg-surface" style="--i: 4"></span>
        <span class="build h-14 rounded-md border border-border bg-surface" style="--i: 5"></span>
        <span class="build h-14 rounded-md border border-border bg-surface" style="--i: 6"></span>
      </div>
    </div>
  </div>
</div>

<style>
  :global(.js) .viz:not([data-inview]) .build {
    opacity: 0;
  }
  .viz[data-inview] .build {
    animation: build 0.7s var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 110ms + 150ms);
  }
  .viz[data-inview] .cta {
    animation: pulse 2.4s ease-in-out 1.6s infinite;
  }
  @keyframes build {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px color-mix(in oklch, var(--accent) 25%, transparent);
    }
  }
</style>
