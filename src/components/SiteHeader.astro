---
import Container from './ui/Container.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import Wordmark from './Wordmark.astro';

const links = [
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#sobre-mi', label: 'Sobre mí' },
  { href: '/#experiencia', label: 'Experiencia' },
  { href: '/#stack', label: 'Stack' },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-bg/75 backdrop-blur-md">
  <Container class="flex h-16 items-center justify-between gap-6">
    <a href="/" class="-mx-2 rounded-md px-2 py-1" aria-label="Inicio — Gabriel Reyes">
      <Wordmark />
    </a>
    <nav aria-label="Principal" class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="rounded-full px-3 py-2 text-sm text-muted transition-colors duration-200 hover:text-fg"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/#contacto"
        class="ml-2 inline-flex h-10 items-center rounded-full bg-fg px-4 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-90"
      >
        Contacto
      </a>
      <ThemeToggle class="ml-1" />
    </nav>
  </Container>
</header>
