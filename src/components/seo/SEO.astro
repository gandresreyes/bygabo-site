---
import type { Thing } from 'schema-dts';
import { isIndexable, shareOrigin } from '../../config/env';
import { SITE } from '../../config/site';
import { buildGraph } from '../../lib/schema';
import JsonLd from './JsonLd.astro';

export interface Props {
  /** Sin plantilla: "Proyectos" → "Proyectos — Gabriel Reyes". Vacío en la home. */
  title?: string;
  /** 120–160 caracteres, única por página. */
  description?: string;
  /** Ruta de la imagen OG (1200×630). */
  image?: string;
  type?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  /** Nodos JSON-LD propios de la página; se suman a Person + WebSite. */
  schema?: Thing[];
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  type = 'website',
  noindex: noindexPage = false,
  schema = [],
} = Astro.props;

// En el entorno de pruebas (*.vercel.app) ninguna página se indexa; canonical y JSON-LD se mantienen.
const noindex = noindexPage || !isIndexable;
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// La imagen se sirve desde el host desde el que se comparte (ver env.ts); canonical sigue en SITE.url.
const imageUrl = new URL(image, shareOrigin).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindexPage && <link rel="canonical" href={canonical} />}
<meta name="author" content={SITE.name} />
{SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
{SITE.verification.bing && <meta name="msvalidate.01" content={SITE.verification.bing} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE.title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
{!noindexPage && <JsonLd data={buildGraph(schema)} />}
