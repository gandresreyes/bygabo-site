---
import { SITE } from '../config/site';
import Container from './ui/Container.astro';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
const socials = [
  { href: SITE.socials.linkedin, label: 'LinkedIn' },
  { href: SITE.socials.github, label: 'GitHub' },
].filter((s) => s.href);
---

<footer class="border-t border-border">
  <Container class="flex flex-col gap-6 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <Wordmark />
      <span>
        © {year} {SITE.name} · {SITE.location.city}, {SITE.location.country}
      </span>
    </div>
    <ul class="flex gap-4">
      {socials.map(({ href, label }) => (
        <li>
          <a href={href} rel="me noopener" target="_blank" class="transition-colors duration-200 hover:text-fg">
            {label}
          </a>
        </li>
      ))}
    </ul>
  </Container>
</footer>
