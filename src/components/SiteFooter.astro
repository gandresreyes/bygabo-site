---
import { SITE, whatsappUrl } from '../config/site';
import Container from './ui/Container.astro';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
// Contacto primero (WhatsApp, email); perfiles profesionales después.
interface FooterLink {
  href: string;
  label: string;
  track?: string;
  rel?: string;
  external?: boolean;
}
const candidates: (FooterLink | false)[] = [
  { href: whatsappUrl, label: 'WhatsApp', track: 'whatsapp_footer', rel: 'noopener', external: true },
  !!SITE.email && { href: `mailto:${SITE.email}`, label: 'Email', track: 'email_footer' },
  !!SITE.socials.linkedin && { href: SITE.socials.linkedin, label: 'LinkedIn', rel: 'me noopener', external: true },
  !!SITE.socials.github && { href: SITE.socials.github, label: 'GitHub', rel: 'me noopener', external: true },
];
const links = candidates.filter((link): link is FooterLink => link !== false);
const legalLinks = [
  { href: '/aviso-legal/', label: 'Aviso legal' },
  { href: '/privacidad/', label: 'Privacidad' },
];
---

<footer class="border-t border-border">
  <Container class="flex flex-col gap-6 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <Wordmark />
        <span>
          © {year} {SITE.name} · {SITE.location.city}, {SITE.location.country}
        </span>
      </div>
      <nav aria-label="Legal">
        <ul class="flex gap-x-5">
          {legalLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="transition-colors duration-200 hover:text-fg">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {links.map(({ href, label, track, rel, external }) => (
        <li>
          <a
            href={href}
            rel={rel}
            target={external ? '_blank' : undefined}
            data-track={track}
            class="transition-colors duration-200 hover:text-fg"
          >
            {label}
            {external && <span class="sr-only">(se abre en una pestaña nueva)</span>}
          </a>
        </li>
      ))}
    </ul>
  </Container>
</footer>
