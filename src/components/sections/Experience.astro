---
import { experience } from '../../data/profile';
import { formatMonth } from '../../lib/format';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section
  id="experiencia"
  class="scroll-mt-16 border-t border-border py-24 md:py-32"
  aria-labelledby="experiencia-title"
>
  <Container>
    <SectionHeader
      id="experiencia-title"
      eyebrow="Experiencia"
      title="De webs a medida a sistemas bancarios."
      highlight="sistemas bancarios"
      lede="Una trayectoria que empezó creando soluciones web para clientes y creció hasta el software financiero, con Angular, Node.js y .NET."
    />
    <div class="relative mt-16" data-progress-scope>
      <!-- Línea de tiempo: se llena con el degradado de firma al recorrer la trayectoria. -->
      <div class="absolute top-0 bottom-0 left-0 w-px bg-border" aria-hidden="true">
        <div class="bg-gradient-signal h-full w-full origin-top" data-progress="y"></div>
      </div>
      <ol class="pl-8 md:pl-12">
        {experience.map((job, i) => (
          <li
            data-reveal
            class:list={[
              'relative grid gap-4 border-b border-border py-10 md:grid-cols-[14rem_1fr] md:gap-12',
              i === 0 && 'pt-0',
            ]}
          >
            <span
              class:list={[
                'absolute -left-8 size-3 -translate-x-1/2 rounded-full border-2 border-accent bg-bg md:-left-12',
                i === 0 ? 'top-1' : 'top-11',
              ]}
              aria-hidden="true"
            />
            <div class="font-mono text-sm text-muted">
              <p>
                <time datetime={job.start}>{formatMonth(job.start)}</time> —{' '}
                {job.end ? <time datetime={job.end}>{formatMonth(job.end)}</time> : 'actualidad'}
              </p>
              <p class="mt-1">{job.location}</p>
            </div>
            <article>
              <h3 class="text-heading">
                {job.role} <span class="text-muted">· {job.company}</span>
              </h3>
              <p class="mt-2 text-pretty text-muted">{job.summary}</p>
              <ul class="mt-5 max-w-[65ch] space-y-2 leading-relaxed">
                {job.highlights.map((h) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.7em] size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    <span class="text-pretty">{h}</span>
                  </li>
                ))}
              </ul>
              {job.stack.length > 0 && (
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
                  {job.stack.map((t) => (
                    <li class="rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted">{t}</li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>
