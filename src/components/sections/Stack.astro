---
import { skills } from '../../data/profile';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';

// Dos filas en marquesina, en sentidos opuestos. La primera copia de cada fila es la lista real
// (accesible); la segunda es solo visual (aria-hidden) para que el bucle no tenga saltos.
const byGroup = Object.fromEntries(skills.map(({ group, items }) => [group, items]));
const rowGroups = [
  ['Frontend', 'Backend', 'Bases de datos'],
  ['IA aplicada', 'Seguridad y auth', 'DevOps y herramientas', 'Forma de trabajo'],
];
const rows = rowGroups.map((groups) =>
  groups.flatMap((group) => (byGroup[group] ?? []).map((name) => ({ name, ai: group === 'IA aplicada' }))),
);
---

<section id="stack" class="scroll-mt-16 border-t border-border py-24 md:py-32" aria-labelledby="stack-title">
  <Container>
    <SectionHeader
      id="stack-title"
      eyebrow="Stack"
      title="Tecnología moderna, de punta a punta."
      highlight="de punta a punta"
      lede="Lo que hay detrás de cada proyecto: del diseño en pantalla a la API, la base de datos y el servidor en producción."
    />
  </Container>
  <div class="mt-16 space-y-3" data-reveal>
    {rows.map((items, row) => (
      <div class="marquee">
        <div class:list={['track', row % 2 === 1 && 'reverse']} style={`--duration: ${items.length * 3.2}s`}>
          {[0, 1].map((copy) => (
            <ul class="flex shrink-0 gap-3" aria-hidden={copy === 1 ? 'true' : undefined}>
              {items.map(({ name, ai }) => (
                <li
                  class:list={[
                    'rounded-full border bg-surface px-4 py-2 text-sm whitespace-nowrap md:px-5 md:py-2.5 md:text-base',
                    ai ? 'border-accent/40' : 'border-border',
                  ]}
                >
                  {ai ? <span class="text-gradient font-medium">{name}</span> : name}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    /* linear a propósito: una marquesina debe avanzar a velocidad constante. */
    animation: marquee var(--duration) linear infinite;
  }
  .track.reverse {
    animation-direction: reverse;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }
</style>
