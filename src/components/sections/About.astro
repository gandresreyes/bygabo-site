---
import { SITE } from '../../config/site';
import { CAREER_START } from '../../data/profile';
import { yearsSince } from '../../lib/format';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';

const years = yearsSince(CAREER_START);

const facts = [
  { label: 'Experiencia', value: `${years}+ años` },
  { label: 'Qué hago', value: 'Páginas web y aplicaciones a medida' },
  { label: 'Base', value: `${SITE.location.city}, ${SITE.location.country}` },
  { label: 'Modalidad', value: 'En remoto, para toda España' },
];
---

<section id="sobre-mi" class="scroll-mt-16 border-t border-border py-24 md:py-32" aria-labelledby="sobre-mi-title">
  <Container class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-24">
    <div>
      <SectionHeader id="sobre-mi-title" eyebrow="Sobre mí" title="Un solo desarrollador para todo tu proyecto." />
      <div data-reveal class="mt-8 max-w-[65ch] space-y-5 text-lg leading-relaxed text-pretty text-muted">
        <p>
          <strong class="font-medium text-fg">{SITE.name}</strong> es desarrollador de páginas web y aplicaciones a
          medida, con más de {years} años de experiencia. Ha creado software para empresas de sectores tan exigentes
          como la banca y los seguros, y hoy pone esa experiencia al servicio de negocios de toda España.
        </p>
        <p>
          Se encarga de todo el proceso: diseño, desarrollo, posicionamiento y puesta en marcha. Tú tienes un solo
          interlocutor y un resultado pensado para durar, no para rehacerse al año.
        </p>
        <p>
          Trabaja a diario con inteligencia artificial y sabe cómo la usan tus clientes para buscar. Por eso prepara
          cada proyecto para que Google y asistentes como ChatGPT lo encuentren y lo recomienden.
        </p>
      </div>
    </div>
    <dl data-reveal class="grid content-start gap-px overflow-hidden rounded-card border border-border bg-border">
      {facts.map(({ label, value }) => (
        <div class="bg-surface p-6">
          <dt class="font-mono text-xs tracking-wider text-muted uppercase">{label}</dt>
          <dd class="mt-2 text-heading">{value}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
