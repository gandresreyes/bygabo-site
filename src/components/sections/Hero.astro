---
import { SITE } from '../../config/site';
import { CAREER_START } from '../../data/profile';
import { yearsSince } from '../../lib/format';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import Container from '../ui/Container.astro';

const years = yearsSince(CAREER_START);

// Sin JS o con movimiento reducido: hero estático con el h1 real.
// Con motion: data-fx="on" alarga la sección y el escenario queda fijo (sticky) mientras
// el scroll "atraviesa" el nombre en partículas.
---

<section class="hero relative isolate" aria-labelledby="hero-title" data-hero>
  <div class="sticky top-16 h-[calc(100svh-4rem)] overflow-hidden" data-hero-stage>
    <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div
      class="glow absolute top-1/2 left-1/2 -z-10 size-[min(40rem,90vw)] -translate-1/2 opacity-50"
      aria-hidden="true"
    ></div>
    <canvas class="pointer-events-none absolute inset-0 size-full" aria-hidden="true" data-hero-canvas></canvas>
    <Container class="relative grid h-full place-items-center py-16 text-center">
      <div>
        <div data-hero-fade>
          <AvailabilityBadge />
          <p class="mt-8 font-mono text-xs tracking-wider text-muted uppercase">
            {SITE.jobTitle} · {SITE.location.city}, {SITE.location.country}
          </p>
        </div>
        <h1 id="hero-title" class="mt-4 text-display text-balance" data-hero-title>
          {SITE.name}
        </h1>
        <div data-hero-fade>
          <p class="mx-auto mt-6 max-w-[46ch] text-lede text-pretty text-muted">
            Construyo aplicaciones y webs rápidas, seguras y fáciles de encontrar. Más de {years} años creando software
            para banca y fintech con Angular, Node.js y .NET.
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a
              href="#proyectos"
              class="inline-flex h-11 items-center rounded-full bg-fg px-6 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-90"
            >
              Ver proyectos
            </a>
            <a
              href="#contacto"
              class="inline-flex h-11 items-center rounded-full border border-border px-6 text-sm font-medium transition-colors duration-200 hover:border-border-strong hover:bg-surface"
            >
              Hablemos
            </a>
          </div>
        </div>
      </div>
    </Container>
    <p
      class="pointer-events-none absolute inset-x-0 bottom-8 hidden text-center font-mono text-xs tracking-wider text-muted uppercase"
      aria-hidden="true"
      data-hero-hint
    >
      Desliza para sumergirte
    </p>
  </div>
</section>

<style>
  /* La altura extra solo existe cuando el efecto está activo. */
  .hero[data-fx='on'] {
    height: 180svh;
  }
  .hero[data-fx='on'] [data-hero-hint] {
    display: block;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import type { ParticleName } from '../fx/particle-name';

  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const stage = hero?.querySelector<HTMLElement>('[data-hero-stage]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const title = hero?.querySelector<HTMLElement>('[data-hero-title]');

  const hasWebGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };

  const themeColors = () => {
    const css = getComputedStyle(document.documentElement);
    return { fg: css.getPropertyValue('--fg'), accent: css.getPropertyValue('--accent') };
  };

  if (hero && stage && canvas && title && hasWebGL()) {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', (context) => {
      let fx: ParticleName | undefined;
      let cancelled = false;

      const onPointer = (e: PointerEvent) =>
        fx?.setPointer((e.clientX / innerWidth) * 2 - 1, (e.clientY / innerHeight) * 2 - 1);
      const themeObserver = new MutationObserver(() => {
        const { fg, accent } = themeColors();
        fx?.setColors(fg, accent);
      });

      const init = async () => {
        await document.fonts.ready;
        const { createParticleName } = await import('../fx/particle-name');
        if (cancelled) return;
        try {
          fx = createParticleName(canvas, stage, title, themeColors());
        } catch {
          return; // sin WebGL utilizable: se queda el <h1> estático
        }
        const particles = fx;

        hero.dataset.fx = 'on';
        addEventListener('pointermove', onPointer, { passive: true });
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

        context.add(() => {
          // El <h1> real ya se pintó (es el LCP); ahora las partículas toman su lugar.
          // Solo opacity (no visibility): sigue en el árbol de accesibilidad.
          gsap.set(title, { opacity: 0 });
          const intro = { value: 0 };
          gsap.to(intro, {
            value: 1,
            duration: 2.4,
            ease: 'power2.out',
            onUpdate: () => particles.setIntro(intro.value),
          });

          ScrollTrigger.create({
            trigger: hero,
            start: 'top top',
            end: 'bottom bottom',
            scrub: true,
            onUpdate: ({ progress }) => particles.setDive(progress),
          });
          gsap.to('[data-hero-fade], [data-hero-hint]', {
            autoAlpha: 0,
            y: -32,
            ease: 'none',
            scrollTrigger: { trigger: hero, start: 'top top', end: '30% top', scrub: true },
          });
        });
        ScrollTrigger.refresh();
      };

      if ('requestIdleCallback' in window) requestIdleCallback(() => void init(), { timeout: 800 });
      else setTimeout(() => void init(), 1);

      return () => {
        cancelled = true;
        removeEventListener('pointermove', onPointer);
        themeObserver.disconnect();
        fx?.destroy();
        delete hero.dataset.fx;
      };
    });
  }
</script>
