---
import { SITE } from '../../config/site';
import { CAREER_START } from '../../data/profile';
import { yearsSince } from '../../lib/format';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import Container from '../ui/Container.astro';

const years = yearsSince(CAREER_START);
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="glow absolute top-1/2 left-1/2 -z-10 size-[min(40rem,90vw)] -translate-1/2 opacity-50"
    aria-hidden="true"
  ></div>
  <Container class="grid min-h-[calc(100svh-4rem)] place-items-center py-24 text-center">
    <div>
      <AvailabilityBadge />
      <p class="mt-8 font-mono text-xs tracking-wider text-muted uppercase">
        {SITE.jobTitle} · {SITE.location.city}, {SITE.location.country}
      </p>
      <h1 id="hero-title" class="mt-4 text-display text-balance">
        {SITE.name}
      </h1>
      <p class="mx-auto mt-6 max-w-[46ch] text-lede text-pretty text-muted">
        Construyo aplicaciones y webs rápidas, seguras y fáciles de encontrar. Más de {years} años creando software para
        banca y fintech con Angular, Node.js y .NET.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#proyectos"
          class="inline-flex h-11 items-center rounded-full bg-fg px-6 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-90"
        >
          Ver proyectos
        </a>
        <a
          href="#contacto"
          class="inline-flex h-11 items-center rounded-full border border-border px-6 text-sm font-medium transition-colors duration-200 hover:border-border-strong hover:bg-surface"
        >
          Hablemos
        </a>
      </div>
    </div>
  </Container>
</section>
