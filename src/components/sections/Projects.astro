---
import { projects } from '../../data/projects';
import Container from '../ui/Container.astro';
import Spotlight from '../ui/Spotlight.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section id="proyectos" class="scroll-mt-16 border-t border-border py-24 md:py-32" aria-labelledby="proyectos-title">
  <Container>
    <SectionHeader
      id="proyectos-title"
      eyebrow="Proyectos"
      title="Proyectos reales, ya funcionando."
      lede="Una página web para un negocio local de León y una aplicación a medida, publicadas y en uso."
    />
    <ul class="mt-16 grid gap-3 lg:grid-cols-2">
      {projects.map((project) => (
        <li
          data-reveal
          data-spotlight
          class="bg-noise group relative isolate flex flex-col overflow-hidden rounded-card border border-border bg-surface p-6 transition-colors duration-200 hover:border-border-strong md:p-8"
        >
          <Spotlight />
          <article class="flex flex-1 flex-col">
            <p class="font-mono text-xs tracking-wider text-muted uppercase">{project.kind}</p>
            <h3 class="mt-3 text-title">{project.name}</h3>
            <p class="mt-4 text-lg text-pretty text-muted">{project.summary}</p>
            <ul class="mt-6 space-y-2 leading-relaxed">
              {project.highlights.map((h) => (
                <li class="flex gap-3">
                  <span class="mt-[0.7em] size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  <span class="text-pretty">{h}</span>
                </li>
              ))}
            </ul>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
              {project.stack.map((t) => (
                <li class="rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted">{t}</li>
              ))}
            </ul>
            <div class="mt-auto flex flex-wrap gap-3 pt-8">
              <a
                href={project.url}
                target="_blank"
                rel="noopener"
                class="inline-flex h-10 items-center gap-2 rounded-full bg-fg px-5 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-90"
              >
                Ver {project.name}
                <span aria-hidden="true">↗</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex h-10 items-center gap-2 rounded-full border border-border px-5 text-sm font-medium transition-colors duration-200 hover:border-border-strong hover:bg-surface-2"
                >
                  Código de {project.name}
                  <span aria-hidden="true">↗</span>
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                </a>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </Container>
</section>
