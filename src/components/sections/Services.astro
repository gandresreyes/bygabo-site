---
import { services } from '../../data/services';
import VizAI from '../services/VizAI.astro';
import VizApp from '../services/VizApp.astro';
import VizBrowser from '../services/VizBrowser.astro';
import VizSpeed from '../services/VizSpeed.astro';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Spotlight from '../ui/Spotlight.astro';

// Bento: cada servicio enseña lo que entrega con una mini-demo animada.
const layout: Record<string, { span: string; viz: typeof VizBrowser }> = {
  'pagina-web-nueva': { span: 'md:col-span-4', viz: VizBrowser },
  'renovar-pagina-web': { span: 'md:col-span-2', viz: VizSpeed },
  'seo-y-visibilidad-en-ia': { span: 'md:col-span-4', viz: VizAI },
  'aplicaciones-web-a-medida': { span: 'md:col-span-2', viz: VizApp },
};
---

<section id="servicios" class="scroll-mt-16 border-t border-border py-24 md:py-32" aria-labelledby="servicios-title">
  <Container>
    <SectionHeader
      id="servicios-title"
      eyebrow="Servicios"
      title="Webs y aplicaciones hechas a tu medida."
      lede="Creo páginas web y aplicaciones desde cero, renuevo las webs que ya no funcionan y las preparo para que te encuentren en Google y en la IA. Tú te ocupas de tu negocio; yo, de la tecnología."
    />
    <ul class="mt-16 grid gap-3 md:grid-cols-6">
      {services.map((service) => {
        const { span, viz: Viz } = layout[service.id] ?? { span: 'md:col-span-3', viz: undefined };
        return (
          <li
            id={service.id}
            data-reveal
            data-spotlight
            class:list={[
              'group bg-noise relative isolate flex scroll-mt-24 flex-col overflow-hidden rounded-card border border-border bg-surface transition-colors duration-200 hover:border-border-strong',
              span,
            ]}
          >
            <Spotlight />
            {Viz && (
              <div class="relative h-64 overflow-hidden border-b border-border">
                <div class="bg-grid absolute inset-0 opacity-70" aria-hidden="true" />
                <div
                  class="glow absolute top-1/2 left-1/2 size-64 -translate-1/2 opacity-30 transition-opacity duration-500 group-hover:opacity-60"
                  aria-hidden="true"
                />
                <Viz />
              </div>
            )}
            <article class="p-6 md:p-8">
              <h3 class="text-heading">{service.name}</h3>
              <p class="mt-3 text-pretty text-muted">{service.summary}</p>
              <ul class="mt-6 space-y-2 leading-relaxed">
                {service.highlights.map((h) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.7em] size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    <span class="text-pretty">{h}</span>
                  </li>
                ))}
              </ul>
            </article>
          </li>
        );
      })}
    </ul>
    <div data-reveal class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a
        href="#contacto"
        data-track="cta_cuentame_proyecto"
        class="inline-flex h-11 items-center rounded-full bg-fg px-6 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-90"
      >
        Cuéntame tu proyecto
      </a>
      <p class="text-sm text-muted">Primera conversación sin compromiso.</p>
    </div>
  </Container>
</section>
