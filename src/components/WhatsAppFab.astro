---
import { whatsappUrl } from '../config/site';

// Botón flotante de WhatsApp, solo en móvil. Aparece después del hero y se oculta en Contacto
// (lo controla scripts/ui.ts con data-visible). Sin JS no se muestra: el contacto sigue en la página.
// Estilo Liquid Glass con la utilidad `glass` de global.css.
---

<a
  href={whatsappUrl}
  rel="noopener"
  target="_blank"
  class="fab glass fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 inline-flex h-12 items-center gap-2 rounded-full pr-5 pl-4 text-sm font-semibold text-fg md:hidden"
  data-fab
  data-track="whatsapp_fab"
>
  <svg class="size-5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"></path>
  </svg>
  WhatsApp
  <span class="sr-only">(se abre en una pestaña nueva)</span>
</a>

<style>
  /* Oculto por defecto (también sin JS); aparece con un leve desplazamiento. */
  .fab {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.25s var(--ease-out-quart),
      transform 0.25s var(--ease-out-quart),
      visibility 0.25s;
  }
  .fab[data-visible] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  /* Al tocarlo, el cristal "cede" un poco, como los controles de iOS. */
  .fab[data-visible]:active {
    transform: scale(0.95);
    transition-duration: 0.1s;
  }
</style>
