---
interface Props {
  /** id del h2, para `aria-labelledby` de la sección. */
  id: string;
  eyebrow: string;
  /** Texto del h2. Para meter marcado dentro (p. ej. ScrambleText), usa el slot "title". */
  title?: string;
  lede?: string;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, lede, align = 'left' } = Astro.props;
---

<header data-reveal class:list={['max-w-[48rem]', align === 'center' && 'mx-auto text-center']}>
  <p class="font-mono text-xs tracking-wider text-muted uppercase">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-title text-balance">
    <slot name="title">{title}</slot>
  </h2>
  {lede && <p class="mt-5 text-lede text-pretty text-muted">{lede}</p>}
</header>
