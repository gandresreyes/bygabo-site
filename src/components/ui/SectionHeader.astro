---
interface Props {
  /** id del h2, para `aria-labelledby` de la sección. */
  id: string;
  eyebrow: string;
  title: string;
  /** Parte del título que se pinta con el degradado de firma (debe aparecer tal cual en `title`). */
  highlight?: string;
  lede?: string;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, highlight, lede, align = 'left' } = Astro.props;
const [before, after] = highlight && title.includes(highlight) ? title.split(highlight) : [title, undefined];
---

<header data-reveal class:list={['max-w-[48rem]', align === 'center' && 'mx-auto text-center']}>
  <p class="font-mono text-xs tracking-wider text-muted uppercase">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-title text-balance">
    {before}
    {after !== undefined && <span class="text-gradient">{highlight}</span>}
    {after}
  </h2>
  {lede && <p class="mt-5 text-lede text-pretty text-muted">{lede}</p>}
</header>
